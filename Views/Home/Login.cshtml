@{
    Layout = null; // Desactivar el Sidebar y Navbar global para esta pantalla
}
<!DOCTYPE html>
<html class="light" lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Iniciar Sesión - Telón Admin</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>

    <!-- Configuración Exacta del Tema Corporativo -->
    <script>
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    colors: {
                        "primary": "#32694e",
                        "primary-container": "#cae6d6",
                        "on-primary-container": "#08452e",
                        "surface": "#fcf9f4",
                        "on-surface": "#1c1c19",
                        "surface-container-low": "#f6f3ee",
                        "on-surface-variant": "#404943",
                        "outline-variant": "#e5e2dd",
                        "secondary-container": "#cae6d6",
                        "on-secondary-container": "#4f685b"
                    }
                }
            }
        }
    </script>

    <!-- Fuentes e Íconos con escape doble (@@) para Razor -->
    <!-- CDN Oficial Completo de Font Awesome 6.5.1 -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.0.1/css/all.min.css" integrity="sha512-2SwdPD6INVrV/lHTZbO2nodKhrnDdJK9/kg2XD1r9uGqPo1cUbujc+IYdlYdEErWNu69gVcYgdxlmVmzTWnetw==" crossorigin="anonymous" referrerpolicy="no-referrer" />

</head>
<body class="bg-[#fdfbf7] flex items-center justify-center min-h-screen p-6">

    <div class="w-full max-w-md bg-[#f6f3ee] border border-black/5 p-8 rounded-[2rem] shadow-xl">
        
        <!-- Encabezado / Logo del Teatro -->
        <div class="flex flex-col items-center text-center mb-8">
            <div class="w-14 h-14 bg-[#32694e] text-white rounded-2xl flex items-center justify-center mb-4 shadow-md">
                <i class="fa-solid fa-masks-theater text-2xl"></i>
            </div>
            <h2 class="text-2xl font-bold text-[#32694e]">Telón Admin</h2>
            <p class="text-xs text-on-surface-variant mt-1">Ecosistema de Gestión Interna</p>
        </div>

        <!-- Mensajes de Error de la API -->
        @if (ViewBag.Error != null)
        {
            <div class="bg-red-50 border border-red-200 text-red-600 rounded-xl p-4 text-sm mb-6 flex items-center gap-3">
                <i class="fa-solid fa-circle-exclamation"></i>
                <span>@ViewBag.Error</span>
            </div>
        }

        <!-- Formulario de Entrada -->
        <form asp-action="Login" asp-controller="Home" method="post" class="space-y-5">
            <div class="flex flex-col gap-1.5">
                <label class="text-xs font-bold text-gray-600 uppercase tracking-wider px-1">Correo Electrónico</label>
                <div class="relative flex items-center">
                    <i class="fa-solid fa-envelope absolute left-4 text-gray-400"></i>
                    <input name="email" type="email" required placeholder="ejemplo@quasar.com" class="w-full bg-[#fdfbf7] border border-gray-200 focus:border-[#32694e] focus:ring-2 focus:ring-[#32694e]/20 rounded-xl pl-11 pr-4 py-3 outline-none text-sm transition-all" />
                </div>
            </div>

            <div class="flex flex-col gap-1.5">
                <label class="text-xs font-bold text-gray-600 uppercase tracking-wider px-1">Contraseña</label>
                <div class="relative flex items-center">
                    <i class="fa-solid fa-lock absolute left-4 text-gray-400"></i>
                    <input name="password" type="password" required placeholder="••••••••" class="w-full bg-[#fdfbf7] border border-gray-200 focus:border-[#32694e] focus:ring-2 focus:ring-[#32694e]/20 rounded-xl pl-11 pr-4 py-3 outline-none text-sm transition-all" />
                </div>
            </div>

            <button type="submit" class="w-full mt-2 py-4 bg-[#32694e] text-white font-semibold rounded-2xl flex items-center justify-center gap-2 hover:bg-[#254f3b] transition-all shadow-md active:scale-[0.98]">
                <span>Ingresar al Sistema</span>
                <i class="fa-solid fa-arrow-right text-sm"></i>
            </button>
        </form>

        <p class="text-center text-xs text-gray-400 mt-8">
            Quasar Ticketing System &copy; 2026
        </p>
    </div>

</body>
</html>
