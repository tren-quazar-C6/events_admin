@{
    ViewData["Title"] = "Admin Dashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- ===== BIENVENIDA ===== -->
<section class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-10 animate-fade-in">
    <div>
        <p class="text-xs font-bold text-on-surface-variant uppercase tracking-widest mb-1">Bienvenido de nuevo</p>
        <h3 class="text-3xl font-extrabold text-on-surface tracking-tight mb-2">¡Hola, Eduardo! 👋</h3>
        <p class="text-sm text-on-surface-variant max-w-xl">
            Aquí tienes el estado general del teatro para hoy. Monitorea ventas de taquilla física, digital y el aforo en tiempo real.
        </p>
    </div>
    <a href="@Url.Action("Create","Events")"
       class="bg-primary text-white px-6 py-3 rounded-full font-semibold flex items-center justify-center gap-2 hover:bg-primary-dark active:scale-95 transition-all shadow-md whitespace-nowrap text-sm">
        <i class="fa-solid fa-calendar-plus"></i> Programar Función
    </a>
</section>

<!-- ===== KPI CARDS ===== -->
<section class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 mb-10">

    <!-- Ventas del mes -->
    <div class="bg-white rounded-3xl p-6 border border-black/5 shadow-sm flex flex-col justify-between hover:shadow-md transition-all animate-slide-up" style="animation-delay:.05s">
        <div class="flex justify-between items-center mb-4">
            <span class="text-xs font-bold text-on-surface-variant uppercase tracking-wider">Ventas del Mes</span>
            <div class="w-10 h-10 bg-emerald-50 text-primary rounded-xl flex items-center justify-center">
                <i class="fa-solid fa-wallet text-lg"></i>
            </div>
        </div>
        <div>
            <h4 class="text-3xl font-black text-on-surface mb-1">$42,850.00</h4>
            <p class="text-xs text-emerald-600 font-semibold flex items-center gap-1">
                <i class="fa-solid fa-arrow-trend-up"></i> +12.4% vs mes anterior
            </p>
        </div>
        <!-- Mini bar chart decorativo -->
        <div class="flex items-end gap-1 mt-4 h-8">
            @foreach(var h in new[]{40,55,35,70,60,80,65,90,75,85,95,88})
            {
                <div class="flex-1 bg-primary-light rounded-sm" style="height:@(h)%"></div>
            }
        </div>
    </div>

    <!-- Eventos activos -->
    <div class="bg-white rounded-3xl p-6 border border-black/5 shadow-sm flex flex-col justify-between hover:shadow-md transition-all animate-slide-up" style="animation-delay:.1s">
        <div class="flex justify-between items-center mb-4">
            <span class="text-xs font-bold text-on-surface-variant uppercase tracking-wider">Espectáculos en Cartelera</span>
            <div class="w-10 h-10 bg-blue-50 text-blue-600 rounded-xl flex items-center justify-center">
                <i class="fa-solid fa-masks-theater text-lg"></i>
            </div>
        </div>
        <div>
            <h4 class="text-3xl font-black text-on-surface mb-1">18 Eventos</h4>
            <p class="text-xs text-on-surface-variant">4 producciones nuevas esta semana</p>
        </div>
        <div class="flex items-center mt-4">
            @foreach(var i in new[]{10,20,30,40,50})
            {
                <img src="https://i.pravatar.cc/28?img=@i" class="w-7 h-7 rounded-full border-2 border-white -ml-2 first:ml-0 object-cover" />
            }
            <span class="ml-2 text-xs text-on-surface-variant font-semibold">+15 más</span>
        </div>
    </div>

    <!-- Aforo hoy -->
    <div class="bg-white rounded-3xl p-6 border border-black/5 shadow-sm flex flex-col justify-between hover:shadow-md transition-all animate-slide-up" style="animation-delay:.15s">
        <div class="flex justify-between items-center mb-4">
            <span class="text-xs font-bold text-on-surface-variant uppercase tracking-wider">Aforo Validado Hoy</span>
            <div class="w-10 h-10 bg-amber-50 text-amber-600 rounded-xl flex items-center justify-center">
                <i class="fa-solid fa-user-check text-lg"></i>
            </div>
        </div>
        <div>
            <h4 class="text-3xl font-black text-on-surface mb-1">1,248 Boletas</h4>
            <p class="text-xs text-amber-600 font-semibold flex items-center gap-1">
                <i class="fa-solid fa-bolt"></i> 82% Índice de llenado global
            </p>
        </div>
        <div class="mt-4">
            <div class="w-full bg-amber-100 rounded-full h-2">
                <div class="bg-amber-500 h-2 rounded-full" style="width:82%"></div>
            </div>
            <p class="text-[10px] text-on-surface-variant mt-1.5">82% de capacidad total</p>
        </div>
    </div>
</section>

<!-- ===== CONTENIDO DIVIDIDO ===== -->
<section class="grid grid-cols-1 lg:grid-cols-3 gap-6">

    <!-- PRÓXIMAS FUNCIONES -->
    <div class="lg:col-span-2 bg-white rounded-3xl p-6 border border-black/5 shadow-sm animate-slide-up" style="animation-delay:.2s">
        <div class="flex justify-between items-center mb-6">
            <h4 class="font-bold text-lg text-on-surface">Próximas Funciones en Sala</h4>
            <a href="@Url.Action("Index","Eventos")" class="text-xs font-bold text-primary hover:underline flex items-center gap-1">
                Ver cartelera completa <i class="fa-solid fa-chevron-right text-[10px]"></i>
            </a>
        </div>
        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse">
                <thead>
                    <tr class="border-b border-black/5 text-xs text-on-surface-variant uppercase tracking-wider">
                        <th class="pb-3 font-semibold">Espectáculo</th>
                        <th class="pb-3 font-semibold">Fecha y Hora</th>
                        <th class="pb-3 font-semibold">Sala</th>
                        <th class="pb-3 font-semibold text-right">Ocupación</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-black/5 text-sm">
                    @{
                        var funciones = new[] {
                            new { nombre="Romeo y Julieta",        tipo="Drama Clásico",  fecha="May 29, 2026 – 20:00", sala="Sala Principal",      pct=95, badge="bg-emerald-100 text-emerald-800" },
                            new { nombre="El Lago de los Cisnes",  tipo="Ballet",         fecha="Jun 02, 2026 – 18:30", sala="Sala Principal",      pct=60, badge="bg-amber-100 text-amber-800"   },
                            new { nombre="Stand-Up Comedy Show",   tipo="Comedia",        fecha="Jun 05, 2026 – 21:00", sala="Teatro Experimental", pct=45, badge="bg-blue-100 text-blue-800"     },
                            new { nombre="La Traviata",            tipo="Ópera",          fecha="Jun 10, 2026 – 19:00", sala="Sala Principal",      pct=78, badge="bg-violet-100 text-violet-800" },
                        };
                    }
                    @foreach(var f in funciones)
                    {
                        <tr class="hover:bg-surface/50 transition-colors">
                            <td class="py-4">
                                <p class="font-semibold text-primary">@f.nombre</p>
                                <p class="text-[11px] text-on-surface-variant">@f.tipo</p>
                            </td>
                            <td class="py-4 text-on-surface-variant text-xs">@f.fecha</td>
                            <td class="py-4 text-on-surface-variant text-xs">@f.sala</td>
                            <td class="py-4 text-right">
                                <span class="inline-block @f.badge text-xs px-2.5 py-0.5 rounded-full font-bold">@f.pct% Lleno</span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- MONITOREO DE TAQUILLA -->
    <div class="bg-white rounded-3xl p-6 border border-black/5 shadow-sm flex flex-col animate-slide-up" style="animation-delay:.25s">
        <div class="flex justify-between items-center mb-6">
            <h4 class="font-bold text-lg text-on-surface">Monitoreo de Taquilla</h4>
            <span class="w-2.5 h-2.5 rounded-full bg-emerald-500 animate-pulse" title="En vivo"></span>
        </div>

        <div class="space-y-3 grow">
            @{
                var transacciones = new[] {
                    new { canal="andromeda. (Web)",      sub="Hace 2 min · carlo@email.com",  monto="+$120.00", icon="fa-desktop", bg="bg-primary-light", fg="text-primary-deep" },
                    new { canal="tickets. (Taquilla)",   sub="Hace 15 min · Presencial",      monto="+$45.00",  icon="fa-receipt", bg="bg-amber-100",     fg="text-amber-800"    },
                    new { canal="andromeda. (Web)",      sub="Hace 40 min · luisa@email.com", monto="+$90.00",  icon="fa-desktop", bg="bg-primary-light", fg="text-primary-deep" },
                    new { canal="tickets. (Taquilla)",   sub="Hace 1h · Presencial",          monto="+$60.00",  icon="fa-receipt", bg="bg-amber-100",     fg="text-amber-800"    },
                };
            }
            @foreach(var t in transacciones)
            {
                <div class="flex items-center justify-between p-3 rounded-2xl bg-surface/40 border border-black/5">
                    <div class="flex items-center gap-3">
                        <div class="w-9 h-9 @t.bg @t.fg rounded-xl flex items-center justify-center text-xs">
                            <i class="fa-solid @t.icon"></i>
                        </div>
                        <div>
                            <p class="text-xs font-bold text-on-surface">@t.canal</p>
                            <p class="text-[10px] text-on-surface-variant">@t.sub</p>
                        </div>
                    </div>
                    <span class="text-xs font-black text-primary">@t.monto</span>
                </div>
            }
        </div>

        <a href="@Url.Action("Index","Ventas")"
           class="mt-5 w-full border border-black/10 text-on-surface-variant hover:border-primary hover:text-primary py-2.5 rounded-2xl text-xs font-semibold text-center transition-all block">
            Ver historial completo
        </a>
    </div>
</section>

<!-- ===== MÉTRICAS RÁPIDAS EXTRA ===== -->
<section class="grid grid-cols-1 sm:grid-cols-3 gap-6 mt-6">

    <div class="bg-primary rounded-3xl p-6 text-white flex items-center justify-between animate-slide-up" style="animation-delay:.3s">
        <div>
            <p class="text-xs font-bold uppercase tracking-wider text-primary-light/80 mb-1">Usuarios Registrados</p>
            <h4 class="text-3xl font-black">3,842</h4>
            <p class="text-xs text-primary-light mt-1">+127 esta semana</p>
        </div>
        <div class="w-14 h-14 bg-white/10 rounded-2xl flex items-center justify-center">
            <i class="fa-solid fa-users text-2xl text-white"></i>
        </div>
    </div>

    <div class="bg-white rounded-3xl p-6 border border-black/5 shadow-sm flex items-center justify-between animate-slide-up" style="animation-delay:.35s">
        <div>
            <p class="text-xs font-bold uppercase tracking-wider text-on-surface-variant mb-1">PQRS Pendientes</p>
            <h4 class="text-3xl font-black text-on-surface">12</h4>
            <p class="text-xs text-red-500 font-semibold mt-1 flex items-center gap-1">
                <i class="fa-solid fa-triangle-exclamation"></i> 3 sin responder hoy
            </p>
        </div>
        <div class="w-14 h-14 bg-red-50 rounded-2xl flex items-center justify-center">
            <i class="fa-solid fa-comments text-2xl text-red-500"></i>
        </div>
    </div>

    <div class="bg-white rounded-3xl p-6 border border-black/5 shadow-sm flex items-center justify-between animate-slide-up" style="animation-delay:.4s">
        <div>
            <p class="text-xs font-bold uppercase tracking-wider text-on-surface-variant mb-1">Escaneos de Hoy</p>
            <h4 class="text-3xl font-black text-on-surface">1,031</h4>
            <p class="text-xs text-on-surface-variant mt-1">2 intentos inválidos detectados</p>
        </div>
        <div class="w-14 h-14 bg-violet-50 rounded-2xl flex items-center justify-center">
            <i class="fa-solid fa-qrcode text-2xl text-violet-600"></i>
        </div>
    </div>

</section>