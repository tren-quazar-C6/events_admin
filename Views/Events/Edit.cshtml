@model CreateEventoFormModel
@{
    ViewData["Title"] = "Editar Evento";
    ViewData["FormAction"] = "Edit";
    ViewData["SubmitText"] = "Guardar Cambios";
    ViewData["Heading"] = "Editar Evento";
    ViewData["Description"] = "Ajuste la información del evento y guarde los cambios.";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@if (TempData["Error"] != null || ViewBag.Error != null)
{
    <div class="mb-6 flex items-center justify-between gap-3 p-4 bg-red-50 border border-red-200 rounded-2xl text-sm text-red-700">
        <div class="flex items-center gap-3">
            <i class="fa-solid fa-circle-xmark text-red-500 shrink-0"></i>
            <span class="whitespace-pre-line">@(TempData["Error"] ?? ViewBag.Error)</span>
        </div>
    </div>
}

@if (TempData["Success"] != null)
{
    <div class="mb-6 flex items-center justify-between gap-3 p-4 bg-green-50 border border-green-200 rounded-2xl text-sm text-green-700">
        <div class="flex items-center gap-3">
            <i class="fa-solid fa-circle-check text-green-500 shrink-0"></i>
            <span class="whitespace-pre-line">@TempData["Success"]</span>
        </div>
    </div>
}

<div class="mb-6 animate-fade-in">
    <a href="@Url.Action("Detail", "Events", new { id = Model.id_evento ?? 0 })"
       class="inline-flex items-center gap-2 text-sm text-on-surface-variant hover:text-primary transition-colors font-medium">
        <i class="fa-solid fa-arrow-left text-xs"></i> Volver al detalle
    </a>
</div>

<partial name="_EventForm" model="Model" />
