@{
    ViewData["Title"] = "Crear Nuevo Evento";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- Alertas -->
@* @if (TempData["Error"] != null || ViewBag.Error != null) *@
@* { *@
@*     <div class="mb-6 flex items-center gap-3 p-4 bg-red-50 border border-red-200 rounded-2xl text-sm text-red-700 animate-fade-in"> *@
@*         <i class="fa-solid fa-circle-xmark text-red-500 shrink-0"></i> *@
@*         <span>@(TempData["Error"] ?? ViewBag.Error)</span> *@
@*     </div> *@
@* } *@

@if (TempData["Error"] != null || ViewBag.Error != null)
{
    <div id="error-alert"
         class="mb-6 flex items-center justify-between gap-3 p-4 bg-red-50 border border-red-200 rounded-2xl text-sm text-red-700 transition-opacity duration-300">

        <div class="flex items-center gap-3">
            <i class="fa-solid fa-circle-check text-red-500 shrink-0"></i>
            <span>@TempData["Error"]</span>
        </div>

        <button type="button"
                onclick="closeAlert()"
                class="text-red-500 hover:text-red-700">
            <i class="fa-solid fa-xmark"></i>
        </button>
    </div>

    <script>
        function closeAlert() {
            const alert = document.getElementById('error-alert');
            alert.classList.add('opacity-0');

            setTimeout(() => {
                alert.remove();
            }, 300);
        }
    </script>
}
@* @if (TempData["Warning"] != null) *@
@* { *@
@*     <div class="mb-6 flex items-center gap-3 p-4 bg-amber-50 border border-amber-200 rounded-2xl text-sm text-amber-700 animate-fade-in"> *@
@*         <i class="fa-solid fa-triangle-exclamation text-amber-500 shrink-0"></i> *@
@*         <span>@TempData["Warning"]</span> *@
@*     </div> *@
@* } *@
@if (TempData["Warning"] != null)
{
    <div id="warning-alert"
         class="mb-6 flex items-center justify-between gap-3 p-4 bg-amber-50 border border-amber-200 rounded-2xl text-sm text-amber-700 transition-opacity duration-300">

        <div class="flex items-center gap-3">
            <i class="fa-solid fa-circle-check text-amber-500 shrink-0"></i>
            <span>@TempData["Warning"]</span>
        </div>

        <button type="button"
                onclick="closeAlert()"
                class="text-amber-500 hover:text-amber-700">
            <i class="fa-solid fa-xmark"></i>
        </button>
    </div>

    <script>
        function closeAlert() {
            const alert = document.getElementById('warning-alert');
            alert.classList.add('opacity-0');

            setTimeout(() => {
                alert.remove();
            }, 300);
        }
    </script>
}

@if (TempData["Success"] != null)
{
    <div id="success-alert"
         class="mb-6 flex items-center justify-between gap-3 p-4 bg-green-50 border border-green-200 rounded-2xl text-sm text-green-700 transition-opacity duration-300">

        <div class="flex items-center gap-3">
            <i class="fa-solid fa-circle-check text-green-500 shrink-0"></i>
            <span>@TempData["success"]</span>
        </div>

        <button type="button"
                onclick="closeAlert()"
                class="text-green-500 hover:text-green-700">
            <i class="fa-solid fa-xmark"></i>
        </button>
    </div>

    <script>
        function closeAlert() {
            const alert = document.getElementById('success-alert');
            alert.classList.add('opacity-0');

            setTimeout(() => {
                alert.remove();
            }, 300);
        }
    </script>
}

<!-- Back -->
<div class="mb-6 animate-fade-in">
    <a href="@Url.Action("Index", "Events")"
       class="inline-flex items-center gap-2 text-sm text-on-surface-variant hover:text-primary transition-colors font-medium">
        <i class="fa-solid fa-arrow-left text-xs"></i> Volver a Eventos
    </a>
</div>

