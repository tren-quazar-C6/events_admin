<!-- Modal descartar -->
<div id="modal-descartar" class="fixed inset-0 z-50 hidden items-center justify-center">
    <div class="absolute inset-0 bg-black/40 backdrop-blur-sm" onclick="cerrarDescartar()"></div>
    <div class="relative bg-white rounded-3xl p-8 w-full max-w-sm mx-4 shadow-2xl">
        <div class="w-14 h-14 bg-red-50 rounded-2xl flex items-center justify-center mx-auto mb-4">
            <i class="fa-regular fa-trash-can text-red-500 text-2xl"></i>
        </div>
        <h3 class="text-lg font-bold text-on-surface text-center mb-2">¿Descartar cambios?</h3>
        <p class="text-sm text-on-surface-variant text-center mb-6">Perderás toda la información ingresada.</p>
        <div class="flex gap-3">
            <button onclick="cerrarDescartar()"
                    class="flex-1 py-2.5 rounded-2xl border border-black/10 text-on-surface-variant text-sm font-semibold hover:bg-surface transition-all">
                Cancelar
            </button>
            <a href="@Url.Action("Index", "Events")"
               class="flex-1 py-2.5 rounded-2xl bg-red-500 text-white text-sm font-semibold text-center hover:bg-red-600 transition-all">
                Sí, descartar
            </a>
        </div>
    </div>
</div>

@section Scripts {
    <style>
        .form-label {
            display: block;
            font-size: .65rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: .06em;
            color: #6b6b63;
            margin-bottom: .4rem;
        }

        .form-input {
            width: 100%;
            padding: .7rem 1rem;
            background: #f6f3ee;
            border-radius: 1rem;
            border: 1px solid rgba(0, 0, 0, .08);
            font-size: .875rem;
            color: #1c1c19;
            transition: all .2s;
        }

        .form-input:focus {
            outline: none;
            box-shadow: 0 0 0 3px rgba(50, 105, 78, .15);
            border-color: rgba(50, 105, 78, .35);
        }

        .toolbar-btn {
            width: 1.75rem;
            height: 1.75rem;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: .5rem;
            font-size: .8rem;
            color: #6b6b63;
            cursor: pointer;
            transition: all .15s;
        }

        .toolbar-btn:hover {
            background: #e8e4dd;
            color: #1c1c19;
        }

        #editor:empty:before {
            content: attr(data-ph);
            color: rgba(107, 107, 99, .4);
            pointer-events: none;
        }

        input[type=radio]:checked ~ div {
            border-color: #32694e !important;
            background: rgba(202, 230, 214, .2) !important;
        }

        input[type=radio]:checked ~ div .hidden {
            display: flex !important;
        }
    </style>
    <script>
        // Editor
        function fmt(cmd) {
            document.getElementById('editor').focus();
            document.execCommand(cmd, false, null);
        }

        function syncEditor() {
            document.getElementById('desc-hidden').value = document.getElementById('editor').innerHTML;
        }

        document.getElementById('form-evento').addEventListener('submit', syncEditor);

        // Zona manual
        function toggleZonaManual(radio) {
            const panel = document.getElementById('zona-manual');
            if (radio.value === 'personalizado') {
                panel.classList.remove('hidden');
                if (!document.getElementById('zonas-lista').children.length) agregarZona();
            }
            

        }

        document.querySelectorAll('input[name="plantilla_sala"]').forEach(r => {
            r.addEventListener('change', () => {
                if (r.value !== 'personalizado')
                    document.getElementById('zona-manual').classList.add('hidden');
                else toggleZonaManual(r);
            });
        });

        let zi = 0;

        function agregarZona() {
            const d = document.createElement('div');
            d.className = 'flex gap-3 items-center p-3 rounded-2xl bg-surface/60 border border-black/5';
            d.innerHTML = `
        <input type="text" placeholder="Nombre zona" class="form-input flex-1 text-xs py-2"/>
        <div class="relative w-28"><span class="absolute left-3 top-1/2 -translate-y-1/2 text-xs text-on-surface-variant">$</span>
        <input type="number" placeholder="Precio" class="form-input pl-6 text-xs py-2"/></div>
        <input type="number" placeholder="Cap." class="form-input w-20 text-xs py-2"/>
        <button type="button" onclick="this.closest('div.flex').remove()"
                class="w-7 h-7 flex items-center justify-center rounded-lg hover:bg-red-50 text-on-surface-variant hover:text-red-500 transition-all">
            <i class="fa-regular fa-trash-can text-xs"></i>
        </button>`;
            document.getElementById('zonas-lista').appendChild(d);
            zi++;
        }

        // Modal descartar
        function confirmarDescartar() {
            const m = document.getElementById('modal-descartar');
            m.classList.remove('hidden');
            m.classList.add('flex');
        }

        function cerrarDescartar() {
            document.getElementById('modal-descartar').classList.add('hidden');
            document.getElementById('modal-descartar').classList.remove('flex');
        }
    </script>
}