@model EventoZonasFormModel
@{
    ViewData["Title"] = "Configurar Zonas";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@if (TempData["Error"] != null || ViewBag.Error != null)
{
    <div class="mb-6 flex items-center justify-between gap-3 p-4 bg-red-50 border border-red-200 rounded-2xl text-sm text-red-700">
        <div class="flex items-center gap-3">
            <i class="fa-solid fa-circle-xmark text-red-500 shrink-0"></i>
            <span class="whitespace-pre-line">@(TempData["Error"] ?? ViewBag.Error)</span>
        </div>
    </div>
}

@if (TempData["Success"] != null)
{
    <div class="mb-6 flex items-center justify-between gap-3 p-4 bg-green-50 border border-green-200 rounded-2xl text-sm text-green-700">
        <div class="flex items-center gap-3">
            <i class="fa-solid fa-circle-check text-green-500 shrink-0"></i>
            <span class="whitespace-pre-line">@TempData["Success"]</span>
        </div>
    </div>
}

<div class="mb-6">
    <a href="@Url.Action("Detail", "Events", new { id = Model.id_evento })"
       class="inline-flex items-center gap-2 text-sm text-on-surface-variant hover:text-primary transition-colors font-medium">
        <i class="fa-solid fa-arrow-left text-xs"></i> Volver al detalle
    </a>
</div>

<section class="bg-white rounded-3xl border border-black/5 shadow-sm p-6 md:p-8">
    <div class="flex flex-col lg:flex-row lg:items-end lg:justify-between gap-4 mb-6">
        <div>
            <p class="text-xs font-bold uppercase tracking-wider text-on-surface-variant mb-1">Configuración de zonas</p>
            <h3 class="text-3xl font-extrabold text-on-surface tracking-tight">@Model.nombre_evento</h3>
            <p class="text-sm text-on-surface-variant mt-1">@Model.tipo_evento · @Model.fecha_evento.ToString("dd/MM/yyyy HH:mm")</p>
        </div>
        <div class="grid grid-cols-3 gap-3 text-sm">
            <div class="bg-surface/50 rounded-2xl p-4 border border-black/5">
                <p class="text-[10px] uppercase tracking-wider text-on-surface-variant font-semibold">Capacidad total</p>
                <p class="text-xl font-black text-on-surface">@Model.capacidad_total.ToString("N0")</p>
            </div>
            <div class="bg-surface/50 rounded-2xl p-4 border border-black/5">
                <p class="text-[10px] uppercase tracking-wider text-on-surface-variant font-semibold">Asignada</p>
                <p class="text-xl font-black text-primary">@Model.capacidad_asignada.ToString("N0")</p>
            </div>
            <div class="bg-surface/50 rounded-2xl p-4 border border-black/5">
                <p class="text-[10px] uppercase tracking-wider text-on-surface-variant font-semibold">Restante</p>
                <p class="text-xl font-black text-amber-600">@Model.capacidad_restante.ToString("N0")</p>
            </div>
        </div>
    </div>

    <form method="post" action="@Url.Action("ConfigureZones", "Events", new { id = Model.id_evento })">
        @Html.AntiForgeryToken()
        <input type="hidden" name="id_evento" value="@Model.id_evento" />
        <input type="hidden" name="nombre_evento" value="@Model.nombre_evento" />
        <input type="hidden" name="tipo_evento" value="@Model.tipo_evento" />
        <input type="hidden" name="fecha_evento" value="@Model.fecha_evento.ToString("O")" />
        <input type="hidden" name="capacidad_total" value="@Model.capacidad_total" />

        <div class="overflow-x-auto border border-black/5 rounded-3xl">
            <table class="w-full text-left border-collapse">
                <thead class="bg-surface/60">
                    <tr class="text-xs uppercase tracking-wider text-on-surface-variant">
                        <th class="p-4 font-semibold">Zona</th>
                        <th class="p-4 font-semibold">Activa</th>
                        <th class="p-4 font-semibold">Precio</th>
                        <th class="p-4 font-semibold">Cargo servicio</th>
                        <th class="p-4 font-semibold">Asientos físicos</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-black/5">
                @for (var i = 0; i < Model.zonas.Count; i++)
                {
                    var zona = Model.zonas[i];
                    <tr class="hover:bg-surface/40 transition-colors">
                        <td class="p-4">
                            <input type="hidden" name="zonas[@i].id_zona" value="@zona.id_zona" />
                            <input type="hidden" name="zonas[@i].nombre_zona" value="@zona.nombre_zona" />
                            <input type="hidden" name="zonas[@i].color_hex" value="@zona.color_hex" />
                            <div class="flex items-center gap-3">
                                <div class="w-9 h-9 rounded-2xl flex items-center justify-center text-xs font-black text-white"
                                     style="background:@(string.IsNullOrWhiteSpace(zona.color_hex) ? "#32694e" : zona.color_hex)">
                                    @zona.nombre_zona.Substring(0, 1).ToUpper()
                                </div>
                                <div>
                                    <p class="font-semibold text-on-surface">@zona.nombre_zona</p>
                                    <p class="text-[11px] text-on-surface-variant">Id zona: @zona.id_zona</p>
                                </div>
                            </div>
                        </td>
                        <td class="p-4">
                            <label class="inline-flex items-center gap-2 cursor-pointer">
                                <input type="checkbox"
                                       name="zonas[@i].activo"
                                       value="true"
                                       @(zona.activo ? "checked" : "")
                                       class="h-4 w-4 rounded border-black/20 text-primary focus:ring-primary" />
                                <span class="text-sm font-medium text-on-surface-variant">Habilitada</span>
                            </label>
                        </td>
                        <td class="p-4">
                            <input type="number"
                                   step="0.01"
                                   min="0"
                                   name="zonas[@i].precio"
                                   value="@zona.precio"
                                   class="form-input" />
                        </td>
                        <td class="p-4">
                            <input type="number"
                                   step="0.01"
                                   min="0"
                                   name="zonas[@i].cargo_servicio"
                                   value="@(zona.cargo_servicio ?? 0)"
                                   class="form-input" />
                        </td>
                        <td class="p-4">
                            <input type="text"
                                   value="@zona.capacidad_fisica"
                                   readonly
                                   class="form-input form-input-readonly" />
                            <p class="mt-2 text-[11px] text-on-surface-variant">
                                Capacidad fija tomada de los asientos activos de la zona.
                            </p>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>

        <div class="flex items-center justify-end gap-3 mt-6">
            <a href="@Url.Action("Detail", "Events", new { id = Model.id_evento })"
               class="px-5 py-3 rounded-2xl border border-black/10 text-sm font-semibold text-on-surface-variant hover:border-primary hover:text-primary transition-all">
                Cancelar
            </a>
            <button type="submit"
                    class="px-6 py-3 rounded-2xl bg-primary text-white text-sm font-semibold hover:bg-primary-dark active:scale-95 transition-all shadow-md">
                Guardar zonas
            </button>
        </div>
    </form>
</section>

<style>
    .form-input {
        width: 100%;
        padding: .7rem .95rem;
        background: #f6f3ee;
        border-radius: 1rem;
        border: 1px solid rgba(0, 0, 0, .08);
        font-size: .875rem;
        color: #1c1c19;
        transition: all .2s;
    }

    .form-input:focus {
        outline: none;
        box-shadow: 0 0 0 3px rgba(50, 105, 78, .15);
        border-color: rgba(50, 105, 78, .35);
    }

    .form-input-readonly {
        background: #eee9e1;
        color: #5b564f;
        cursor: not-allowed;
    }
</style>
