@model CreateEventoFormModel
@{
    var action = ViewData["FormAction"]?.ToString() ?? "Create";
    var submitText = ViewData["SubmitText"]?.ToString() ?? "Guardar";
    var heading = ViewData["Heading"]?.ToString() ?? "Evento";
    var description = ViewData["Description"]?.ToString() ?? string.Empty;
    var routeValues = Model.id_evento.HasValue ? new { id = Model.id_evento.Value } : null;
}

<form id="form-evento"
      method="post"
      action="@Url.Action(action, "Events", routeValues)">
    @Html.AntiForgeryToken()

    @if (Model.id_evento.HasValue)
    {
        <input type="hidden" name="id_evento" value="@Model.id_evento" />
    }

    <div class="mb-8 animate-fade-in">
        <h3 class="text-4xl font-extrabold text-primary tracking-tight mb-2">@heading</h3>
        <p class="text-sm text-on-surface-variant max-w-xl">@description</p>
    </div>

    <div class="bg-white rounded-3xl border border-black/5 shadow-sm p-6 md:p-8 mb-5 animate-slide-up"
         style="animation-delay:.05s">
        <div class="space-y-5">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div class="grid grid-cols-1 gap-4">
                    <div>
                        <label class="form-label">Título del Evento <span class="text-red-400">*</span></label>
                        <input type="text"
                               name="nombre_evento"
                               value="@Model.nombre_evento"
                               placeholder="Ej. El Fantasma de la Ópera"
                               class="form-input"
                               required />
                    </div>
                    <div>
                        <label class="form-label">Categoría <span class="text-red-400">*</span></label>
                        <div class="relative">
                            <select name="id_tipo_evento" class="form-input appearance-none pr-9" required>
                                @if (Model.id_tipo_evento == 0)
                                {
                                    <option value="" disabled selected>Elige una opción</option>
                                }
                                else
                                {
                                    <option value="" disabled>Elige una opción</option>
                                }
                                @if (Model.id_tipo_evento == 1)
                                {
                                    <option value="1" selected>Concierto</option>
                                }
                                else
                                {
                                    <option value="1">Concierto</option>
                                }

                                @if (Model.id_tipo_evento == 2)
                                {
                                    <option value="2" selected>Obra de Teatro</option>
                                }
                                else
                                {
                                    <option value="2">Obra de Teatro</option>
                                }

                                @if (Model.id_tipo_evento == 3)
                                {
                                    <option value="3" selected>Danza</option>
                                }
                                else
                                {
                                    <option value="3">Danza</option>
                                }

                                @if (Model.id_tipo_evento == 4)
                                {
                                    <option value="4" selected>Conferencia</option>
                                }
                                else
                                {
                                    <option value="4">Conferencia</option>
                                }

                                @if (Model.id_tipo_evento == 5)
                                {
                                    <option value="5" selected>Comedia</option>
                                }
                                else
                                {
                                    <option value="5">Comedia</option>
                                }

                                @if (Model.id_tipo_evento == 6)
                                {
                                    <option value="6" selected>Otro</option>
                                }
                                else
                                {
                                    <option value="6">Otro</option>
                                }
                            </select>
                            <i class="fa-solid fa-chevron-down absolute right-3 top-1/2 -translate-y-1/2 text-on-surface-variant text-xs pointer-events-none"></i>
                        </div>
                    </div>
                    <div>
                        <label class="form-label">Ruta imagen <span class="text-red-400">*</span></label>
                        <input type="text"
                               name="ruta_url"
                               value="@Model.ruta_url"
                               placeholder="Ej. Ingrese la ruta de la img"
                               class="form-input"
                               required />
                    </div>
                </div>

                <div>
                    <label class="form-label">Descripción</label>
                    <div class="rounded-2xl border border-black/10 overflow-hidden focus-within:ring-2 focus-within:ring-primary/20">
                        <div class="flex items-center gap-0.5 px-3 py-2 bg-surface border-b border-black/5">
                            <button type="button" onclick="fmt('bold')" class="toolbar-btn font-bold">B</button>
                            <button type="button" onclick="fmt('italic')" class="toolbar-btn italic">I</button>
                            <button type="button" onclick="fmt('insertUnorderedList')" class="toolbar-btn">
                                <i class="fa-solid fa-list-ul text-xs"></i>
                            </button>
                            <div class="w-px h-4 bg-black/10 mx-1"></div>
                            <button type="button" onclick="clearEditor()" class="toolbar-btn">
                                <i class="fa-solid fa-eraser text-xs"></i>
                            </button>
                        </div>
                        <div id="editor"
                             contenteditable="true"
                             class="min-h-[165px] px-4 py-3 text-sm text-on-surface bg-white focus:outline-none"
                             data-ph="Escriba aquí la descripción del evento...">@Html.Raw(Model.descripcion ?? string.Empty)</div>
                    </div>
                    <input type="hidden" name="descripcion" id="desc-hidden" value="@Model.descripcion" />
                </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
                <div>
                    <label class="form-label">Fecha del Evento <span class="text-red-400">*</span></label>
                    <input type="datetime-local" name="fecha_evento" value="@Model.fecha_evento" class="form-input" required />
                    <p class="text-[10px] text-on-surface-variant mt-1">Debe ser fecha futura</p>
                </div>
                <div>
                    <label class="form-label">Inicio de Ventas <span class="text-red-400">*</span></label>
                    <input type="datetime-local" name="fecha_inicio_ventas" value="@Model.fecha_inicio_ventas" class="form-input" required />
                </div>
                <div>
                    <label class="form-label">Cierre de Ventas <span class="text-red-400">*</span></label>
                    <input type="datetime-local" name="fecha_fin_ventas" value="@Model.fecha_fin_ventas" class="form-input" required />
                    <p class="text-[10px] text-on-surface-variant mt-1">Debe ser antes del evento</p>
                </div>
                <div>
                    <label class="form-label">Capacidad Total <span class="text-red-400">*</span></label>
                    <input type="number" name="capacidad_total" value="@Model.capacidad_total" placeholder="Ej. 500" min="1" class="form-input" required />
                </div>
            </div>
        </div>
    </div>

    <div class="flex items-center justify-end gap-4 animate-slide-up pb-6" style="animation-delay:.15s">
        <div class="flex gap-3">
            <button type="submit"
                    name="accion"
                    value="publicar"
                    class="px-6 py-3 rounded-2xl bg-primary text-white text-sm font-semibold hover:bg-primary-dark active:scale-95 transition-all shadow-md">
                @submitText
            </button>
        </div>
    </div>
</form>

<style>
    .form-label {
        display: block;
        font-size: .65rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .06em;
        color: #6b6b63;
        margin-bottom: .4rem;
    }

    .form-input {
        width: 100%;
        padding: .7rem 1rem;
        background: #f6f3ee;
        border-radius: 1rem;
        border: 1px solid rgba(0, 0, 0, .08);
        font-size: .875rem;
        color: #1c1c19;
        transition: all .2s;
    }

    .form-input:focus {
        outline: none;
        box-shadow: 0 0 0 3px rgba(50, 105, 78, .15);
        border-color: rgba(50, 105, 78, .35);
    }

    .toolbar-btn {
        width: 1.75rem;
        height: 1.75rem;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: .5rem;
        font-size: .8rem;
        color: #6b6b63;
        cursor: pointer;
        transition: all .15s;
    }

    .toolbar-btn:hover {
        background: #e8e4dd;
        color: #1c1c19;
    }

    #editor:empty:before {
        content: attr(data-ph);
        color: rgba(107, 107, 99, .4);
        pointer-events: none;
    }
</style>
<script>
    function fmt(cmd) {
        document.getElementById('editor').focus();
        document.execCommand(cmd, false, null);
    }

    function clearEditor() {
        document.getElementById('editor').innerHTML = '';
        syncEditor();
    }

    function syncEditor() {
        document.getElementById('desc-hidden').value = document.getElementById('editor').innerHTML;
    }

    document.addEventListener('DOMContentLoaded', () => {
        const form = document.getElementById('form-evento');
        if (form) {
            form.addEventListener('submit', syncEditor);
        }
        syncEditor();
    });
</script>
