@model IEnumerable<AdminEventoResumenDto>
@{
    ViewData["Title"] = "Gestión de Eventos";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- ===== FILTROS + ACCIÓN ===== -->
<section class="flex flex-col sm:flex-row sm:items-center justify-end gap-4 mb-8 animate-fade-in">
    <a href="@Url.Action("Create", "Events")"
       class="bg-primary text-white px-5 py-2.5 rounded-full font-semibold text-sm flex items-center gap-2 hover:bg-primary-dark active:scale-95 transition-all shadow-md whitespace-nowrap self-start sm:self-auto">
        <i class="fa-solid fa-plus"></i> Nuevo Evento
    </a>
</section>

<!-- ===== TABLA DE EVENTOS ===== -->
<section class="bg-white rounded-3xl border border-black/5 shadow-sm overflow-hidden mb-8 animate-slide-up"
         style="animation-delay:.05s">
    <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse">
            <thead>
            <tr class="border-b border-black/5 bg-surface/60 text-xs text-on-surface-variant uppercase tracking-wider">
                <th class="px-6 py-4 font-semibold">Evento</th>
                <th class="px-6 py-4 font-semibold">Tipo</th>
                <th class="px-6 py-4 font-semibold">Fecha / Hora</th>
                <th class="px-6 py-4 font-semibold">Capacidad</th>
                <th class="px-6 py-4 font-semibold">Estado</th>
                <th class="px-6 py-4 font-semibold">Acciones</th>
            </tr>
            </thead>
            <tbody class="divide-y divide-black/5 text-sm" id="eventos-body">
            @foreach (var e in Model)
            {
                var estadoClase = e.status switch
                {
                    "PUBLISHED" => "bg-emerald-100 text-emerald-700",
                    "DRAFT" => "bg-gray-100 text-gray-600",
                    "CANCELLED" => "bg-red-100 text-red-600",
                    _ => "bg-gray-100 text-gray-600"
                };

                <tr class="hover:bg-surface/40 transition-colors">

                    <!-- Evento -->
                    <td class="px-6 py-4">
                        <div class="flex items-center gap-4">

                            <img src="@(string.IsNullOrEmpty(e.ruta_url)
                                          ? "/images/no-image.png"
                                          : e.ruta_url)"
                                 class="w-12 h-12 rounded-2xl object-cover"/>

                            <div>
                                <p class="font-semibold">
                                    @e.nombre_evento
                                </p>
                            </div>
                        </div>
                    </td>

                    <!-- Categoría -->
                    <td class="px-4 py-4">
                        @e.tipo_evento
                    </td>

                    <!-- Fecha -->
                    <td class="px-4 py-4">
                        <p>
                            @e.fecha_evento.ToString("dd/MM/yyyy")
                        </p>

                        <p class="text-xs text-gray-500">
                            @e.fecha_evento.ToString("HH:mm")
                        </p>
                    </td>

                    <!-- Capacidad -->
                    <td class="px-4 py-4">
                        @e.capacidad_total
                    </td>

                    <!-- Estado -->
                    <td class="px-4 py-4">
                            <span class="@estadoClase px-3 py-1 rounded-full text-xs font-semibold">
                                @e.status
                            </span>
                    </td>

                    <!-- Acciones -->
                    <td class="px-6 py-4 text-right">
                        <a href="@Url.Action("Edit", "Events", new { id = e.id_evento })">
                            <i class="fa-solid fa-pen-to-square"></i>
                            Editar
                        </a>
                        <a href="@Url.Action("Detail", "Events", new { id = e.id_evento })">
                            <i class="fa-solid fa-circle-info"></i>
                            Detalles
                        </a>
                        <a href="@Url.Action("Detail", "Events", new { id = e.id_evento })">
                            Zonas
                        </a>
                    </td>

                </tr>
            }
            </tbody>
        </table>
    </div>

    <!-- Footer tabla: contador + paginación -->
    <div class="px-6 py-4 border-t border-black/5 flex flex-col sm:flex-row items-center justify-between gap-3">
        <p class="text-xs text-on-surface-variant" id="conteo-eventos">
            Mostrando @Model.Count() de @ViewBag.TotalRecords eventos</p>
        <div class="flex items-center gap-1">
            @if (ViewBag.Page > 1)
            {
                <a asp-action="Index"
                   asp-route-page="@(ViewBag.Page - 1)"
                   class="w-8 h-8 flex items-center justify-center rounded-xl hover:bg-surface">
                    <i class="fa-solid fa-chevron-left text-xs"></i>
                </a>
            }
            @for (int p = 1; p <= ViewBag.TotalPages; p++)
            {
                <a asp-action="Index"
                   asp-route-page="@p"
                   class="w-8 h-8 flex items-center justify-center rounded-xl text-xs font-bold transition-all
       @(p == ViewBag.Page
                                     ? "bg-primary text-white shadow-sm"
                                     : "hover:bg-surface text-on-surface-variant")">
                    @p
                </a>
            }
            @if (ViewBag.Page < ViewBag.TotalPages)
            {
                <a asp-action="Index"
                   asp-route-page="@(ViewBag.Page + 1)"
                   class="w-8 h-8 flex items-center justify-center rounded-xl hover:bg-surface">
                    <i class="fa-solid fa-chevron-right text-xs"></i>
                </a>
            }
        </div>
    </div>
</section>

