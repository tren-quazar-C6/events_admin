@section Scripts {
    <style>
        .form-label {
            display: block;
            font-size: .65rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: .06em;
            color: #6b6b63;
            margin-bottom: .4rem;
        }

        .form-input {
            width: 100%;
            padding: .7rem 1rem;
            background: #f6f3ee;
            border-radius: 1rem;
            border: 1px solid rgba(0, 0, 0, .08);
            font-size: .875rem;
            color: #1c1c19;
            transition: all .2s;
        }

        .form-input:focus {
            outline: none;
            box-shadow: 0 0 0 3px rgba(50, 105, 78, .15);
            border-color: rgba(50, 105, 78, .35);
        }
    </style>
    <script>
        // ── Avatar dinámico por iniciales ───────────
        const avatarColorClasses = [
            'bg-emerald-100 text-emerald-700',
            'bg-blue-100 text-blue-700',
            'bg-violet-100 text-violet-700',
            'bg-amber-100 text-amber-700',
            'bg-rose-100 text-rose-700',
            'bg-cyan-100 text-cyan-700',
        ];
        let currentAvatarClass = avatarColorClasses[0];

        function actualizarAvatar() {
            const nombre = document.getElementById('inp-nombre').value.trim();
            const cargo = document.getElementById('inp-cargo')?.value.trim() || '';
            const rolSel = document.getElementById('sel-rol');
            const rolText = rolSel.options[rolSel.selectedIndex]?.text || '';

            // Iniciales (máx 2)
            const palabras = nombre.split(' ').filter(Boolean);
            const iniciales = palabras.length >= 2
                ? (palabras[0][0] + palabras[1][0]).toUpperCase()
                : nombre.length > 0 ? nombre[0].toUpperCase() : '??';

            document.getElementById('avatar-iniciales').textContent = iniciales;
            document.getElementById('avatar-nombre').textContent = nombre || 'Nombre Completo';
            document.getElementById('avatar-cargo').textContent = cargo || rolText || 'Cargo / Rol';
        }

        function setAvatarColor(classes) {
            currentAvatarClass = classes;
            const circle = document.getElementById('avatar-circle');
            // Quitar todas las clases de color anteriores
            circle.className = `w-24 h-24 rounded-3xl flex items-center justify-center text-3xl font-black mb-4 shadow-sm select-none transition-all duration-300 ${classes}`;
            // Marcar botón activo
            document.querySelectorAll('[data-classes]').forEach(btn => {
                btn.classList.toggle('ring-2', btn.dataset.classes === classes);
                btn.classList.toggle('ring-primary', btn.dataset.classes === classes);
                btn.classList.toggle('ring-offset-1', btn.dataset.classes === classes);
            });
        }

        function resetAvatar() {
            document.getElementById('avatar-iniciales').textContent = '??';
            document.getElementById('avatar-nombre').textContent = 'Nombre Completo';
            document.getElementById('avatar-cargo').textContent = 'Cargo / Rol';
            setAvatarColor(avatarColorClasses[0]);
        }

        // ── Toggle contraseña ───────────────────────
        function togglePass() {
            const inp = document.getElementById('inp-pass');
            const icon = document.getElementById('icon-pass');
            const show = inp.type === 'password';
            inp.type = show ? 'text' : 'password';
            icon.className = show ? 'fa-regular fa-eye-slash text-sm' : 'fa-regular fa-eye text-sm';
        }

        // ── Validación permisos antes de submit ─────
        document.getElementById('form-staff').addEventListener('submit', e => {
            const admin = document.querySelector('[name="permiso_admin"]').checked;
            const tickets = document.querySelector('[name="permiso_tickets"]').checked;
            const access = document.querySelector('[name="permiso_access"]').checked;
            if (!admin && !tickets && !access) {
                e.preventDefault();
                alert('Debes asignar al menos un permiso de portal al empleado.');
            }
            

        });
    </script>
}
