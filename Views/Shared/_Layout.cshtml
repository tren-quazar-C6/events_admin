<!DOCTYPE html>
<html class="light" lang="es">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>@ViewData["Title"] - Telón Admin</title>

    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>

    <!-- Configuración Exacta del Tema Corporativo -->
    <script>
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    colors: {
                        "primary": "#32694e",
                        "primary-container": "#cae6d6",
                        "on-primary-container": "#08452e",
                        "surface": "#fcf9f4",
                        "on-surface": "#1c1c19",
                        "surface-container-low": "#f6f3ee",
                        "on-surface-variant": "#404943",
                        "outline-variant": "#e5e2dd",
                        "secondary-container": "#cae6d6",
                        "on-secondary-container": "#4f685b"
                    }
                }
            }
        }
    </script>

    <!-- Fuentes e Íconos con escape doble (@@) para Razor -->
    <!-- CDN Oficial Completo de Font Awesome 6.5.1 -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.0.1/css/all.min.css" integrity="sha512-2SwdPD6INVrV/lHTZbO2nodKhrnDdJK9/kg2XD1r9uGqPo1cUbujc+IYdlYdEErWNu69gVcYgdxlmVmzTWnetw==" crossorigin="anonymous" referrerpolicy="no-referrer" />

</head>
<body class="bg-[#fdfbf7] text-on-surface min-h-screen antialiased">

<!-- CONTENEDOR RAÍZ DE LA APLICACIÓN -->
<div class="flex min-h-screen w-full relative">

    <!-- ========================================================= -->
    <!-- 1. SIDEBAR LATERAL (Oculto en móvil, visible en md)       -->
    <!-- ========================================================= -->
    <aside id="sidebar-menu"
           class="fixed inset-y-0 left-0 z-50 w-64 my-4 ml-4 p-6 bg-[#f6f3ee] border border-black/5 rounded-[2rem] flex flex-col transition-transform duration-300 ease-in-out -translate-x-full md:translate-x-0">

        <!-- Encabezado Sidebar -->
        <div class="flex items-center justify-between mb-8 px-2">
            <div class="flex items-center gap-3">
                <div class="w-10 h-10 bg-[#32694e] text-white rounded-2xl flex items-center justify-center">
                    <i class="fa-solid fa-masks-theater"></i>
                </div>
                <div>
                    <h1 class="font-bold text-[#32694e] text-lg leading-tight">Telón Admin</h1>
                    <p class="text-xs text-on-surface-variant">Gestión de teatro</p>
                </div>
            </div>
            <!-- Botón cerrar (Solo móvil) -->
            <button onclick="toggleSidebar()" class="md:hidden p-2 rounded-full hover:bg-black/5">
                <i class="fa-solid fa-xmark"></i>
            </button>
        </div>

        <!-- Navegación Menú -->
        <nav class="flex flex-col gap-1 grow">
            <a class="flex items-center gap-3 py-3 px-4 rounded-xl text-[#32694e] font-semibold bg-[#cae6d6]/40 border-r-4 border-[#32694e]"
               asp-controller="Home" asp-action="Index">
                <i class="fa-solid fa-chart-pie"></i>
                <span class="text-sm">Dashboard</span>
            </a>

            <a class="flex items-center gap-3 py-3 px-4 rounded-xl text-on-surface-variant hover:bg-black/5 transition-colors"
               href="#">
                <i class="fa-solid fa-ticket"></i>
                <span class="text-sm">Eventos</span>
            </a>

            <a class="flex items-center gap-3 py-3 px-4 rounded-xl text-on-surface-variant hover:bg-black/5 transition-colors"
               asp-controller="Empleados" asp-action="Index">
                <i class="fa-solid fa-users"></i>
                <span class="text-sm">Empleados</span>
            </a>

            <a class="flex items-center gap-3 py-3 px-4 rounded-xl text-on-surface-variant hover:bg-black/5 transition-colors"
               href="#">
                <i class="fa-solid fa-gear"></i>
                <span class="text-sm">Configuración</span>
            </a>
        </nav>

        <!-- Botón Acción Inferior -->
        <div class="pt-4 border-t border-black/5">
            <button
                class="w-full py-4 bg-[#32694e] text-white font-semibold rounded-2xl flex items-center justify-center gap-2 hover:bg-[#254f3b] transition-all shadow-sm">
                <i class="fa-solid fa-plus"></i>
                <span class="text-sm">Nuevo Evento</span>
            </button>
        </div>
    </aside>

    <!-- Fondo Oscuro de Capa (Solo móvil cuando el menú está abierto) -->
    <div id="sidebar-overlay" onclick="toggleSidebar()"
         class="fixed inset-0 bg-black/20 backdrop-blur-sm z-40 hidden md:hidden"></div>

    <!-- ========================================================= -->
    <!-- 2. CONTENEDOR DEL CONTENIDO PRINCIPAL                      -->
    <!-- ========================================================= -->
    <div class="flex-1 flex flex-col md:pl-72 min-w-0 min-h-screen">

        <!-- NAVBAR SUPERIOR -->
        <header
            class="flex justify-between items-center w-full px-6 md:px-12 h-20 bg-[#fdfbf7]/80 backdrop-blur-md sticky top-0 z-30">
            <div class="flex items-center gap-4">
                <!-- Botón Hamburguesa Móvil (¡Aquí está el que faltaba!) -->
                <button onclick="toggleSidebar()"
                        class="md:hidden p-2 rounded-xl bg-[#f6f3ee] border border-black/5 text-[#32694e]">
                    <i class="fa-solid fa-bars"></i>
                </button>
                <h2 class="text-xl font-bold text-[#32694e]">Admin Dashboard</h2>
            </div>

            <!-- Buscador e Info Perfil -->
            <div class="flex items-center gap-4">
                <div class="hidden lg:flex items-center bg-[#f6f3ee] rounded-full px-4 py-2 border border-black/5">
                    <i class="fa-solid fa-magnifying-glass mr-2"></i>
                    <input class="bg-transparent border-none outline-none text-sm w-48"
                           placeholder="Buscar eventos, ventas..." type="text"/>
                </div>

                <button class="p-2 rounded-full hover:bg-black/5 text-on-surface-variant relative">
                    <i class="fa-solid fa-bell"></i>
                </button>

                <div class="flex items-center gap-3 border-l border-black/5 pl-4">
                    <div class="flex flex-col text-right hidden sm:flex">
                        <span class="font-bold text-sm text-on-surface">Eduardo V.</span>
                        <span class="text-[10px] text-on-surface-variant uppercase tracking-wider font-semibold">Gerente General</span>
                    </div>
                    <div class="w-10 h-10 rounded-xl overflow-hidden border border-[#32694e]/20 shadow-sm">
                        <img class="w-full h-full object-cover" src="https://ui-avatars.com"/>
                    </div>
                </div>
            </div>
        </header>

        <!-- CONTENIDO DE LAS VISTAS INDEPENDIENTES (BENTO CANVAS) -->
        <div class="flex-1 p-6 md:p-12 pt-2 max-w-7xl w-full mx-auto">
            @RenderBody()
        </div>

    </div>
</div>

<!-- ========================================================= -->
<!-- 3. INTERACTIVIDAD RESPONSIVA (MÓVIL)                       -->
<!-- ========================================================= -->
<script>
    function toggleSidebar() {
        const sidebar = document.getElementById("sidebar-menu");
        const overlay = document.getElementById("sidebar-overlay");

        if (sidebar.classList.contains("-translate-x-full")) {
            // Abrir menú en móvil
            sidebar.classList.remove("-translate-x-full");
            overlay.classList.remove("hidden");
        } else {
            // Cerrar menú en móvil
            sidebar.classList.add("-translate-x-full");
            overlay.classList.add("hidden");
        }
    }
</script>

@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
